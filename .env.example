# ── Fase 1 (base) ──
# Supabase → Connect → "Transaction pooler" (porta 6543) para o site, "Session pooler" (5432) para migrações
DATABASE_URL="postgres://postgres.REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgres://postgres.REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
DATABASE_POOL_MAX=""        # use "1" com o banco local do prisma dev
SESSION_SECRET=""          # node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ROOT_DOMAIN="seusite.com.br"   # em dev: localhost:3000
PLATFORM_NAME="Blocos"

# ── Fases seguintes ──
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
RESEND_API_KEY=""
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"
VERCEL_API_TOKEN=""        # domínios customizados (white-label)
VERCEL_PROJECT_ID=""
SENTRY_DSN=""

# Cobrança (Stripe). "true" liga preços, assinatura, teste de 14 dias e limites de plano.
BILLING_ENABLED="false"

# White-label (fase 10)
# Domínios próprios: com VERCEL_API_TOKEN + VERCEL_PROJECT_ID o domínio é registrado na Vercel (SSL automático).
VERCEL_TEAM_ID=
CUSTOM_DOMAIN_CNAME="cname.vercel-dns.com"
CUSTOM_DOMAIN_A="76.76.21.21"
# Emails: sem RESEND_API_KEY, em desenvolvimento os emails são gravados em .data/outbox
EMAIL_FROM_ADDRESS="no-reply@seusite.com.br"
# Arquivos enviados (dev). Em produção: bucket privado do Supabase.
STORAGE_DIR=".data/uploads"

# Produção: primeira carga (npx prisma db seed) SEM dados de demonstração e com a conta do dono
SEED_DEMO="false"
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
SUPABASE_BUCKET="blocos-arquivos"
