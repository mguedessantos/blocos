// Blocos — esquema do banco de dados (multi-tenant).
// Regra: toda tabela pertencente a um cliente tem `organizationId`.
// Acesse os dados sempre pelos helpers em src/lib/dal/*.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Tenancy ─────────────────────────────

enum OrgType {
  ESCOLA
  PROFESSOR_INDEPENDENTE
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // usado no subdomínio: slug.seusite.com.br
  type      OrgType
  city      String   @default("") // cidade da escola (filtros do painel da plataforma)
  state     String   @default("") // UF, ex.: "SP"
  deletedAt DateTime? // removida (lixeira); restaurável por 90 dias
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branding      OrgBranding?
  domains       Domain[]
  users         User[]
  subscription  Subscription?
  classes       Class[]
  tracks        Track[]
  courses       Course[]
  jamTeams      JamTeam[]
  consents      ConsentRecord[]
  auditLogs     AuditLog[]
  invites       Invite[]
  hintRequests  HintRequest[]
}

model OrgBranding {
  id                String       @id @default(cuid())
  organizationId    String       @unique
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  displayName       String?
  logoUrl           String?
  logoDarkUrl       String?
  faviconUrl        String?
  mascotUrl         String?
  loginBackgroundUrl String?
  primaryColor      String? // hex, ex.: #6d28d9
  secondaryColor    String?
  emailSenderName   String?
  supportEmail      String?
  hidePlatformBrand Boolean      @default(false)
  termsUrl          String?
  privacyUrl        String?
  updatedAt         DateTime     @updatedAt
}

enum DomainType {
  SUBDOMINIO
  CUSTOM
}

enum DomainStatus {
  PENDENTE
  VERIFICADO
  ERRO
}

model Domain {
  id             String       @id @default(cuid())
  hostname       String       @unique // ex.: codigo.escolaabc.com.br
  type           DomainType
  status         DomainStatus @default(PENDENTE)
  verifiedAt     DateTime?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

// ───────────────────────────── Usuários ─────────────────────────────

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  TEACHER
  STUDENT
  JUDGE
}

model User {
  id             String        @id @default(cuid())
  role           Role
  name           String // alunos: primeiro nome ou apelido (LGPD)
  email          String?       @unique // equipe e jurados; alunos não têm email
  username       String? // alunos: único dentro da organização
  passwordHash   String
  avatar         String? // id de avatar pré-definido
  xp             Int           @default(0)
  active         Boolean       @default(true)
  deletedAt      DateTime? // removido pelo dono da plataforma (lixeira)
  canOrganizeJams Boolean      @default(false) // pode criar game jams (concedido pelo dono)
  organizationId String? // null apenas para SUPER_ADMIN e jurados externos
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  lastLoginAt    DateTime?

  teachingClasses Class[]       @relation("ClassTeacher")
  enrollments     Enrollment[]
  progress        Progress[]
  submissions     Submission[]
  badges          UserBadge[]
  jamMemberships  JamTeamMember[]
  jamJudging      JamJudge[]
  jamScores       JamScore[]
  jamFeedbacks    JamFeedback[]
  hintRequests    HintRequest[]
  announcementReads AnnouncementRead[]

  @@unique([organizationId, username])
}

model Invite {
  id             String       @id @default(cuid())
  email          String
  role           Role
  token          String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

// ───────────────────────────── Cobrança ─────────────────────────────

model Plan {
  id               String         @id // ex.: "professor", "escola", "escola_plus"
  name             String
  description      String         @default("")
  order            Int            @default(0)
  orgType          OrgType        @default(ESCOLA) // para quem o plano é vendido
  priceCents       Int            @default(0) // preço mensal em centavos (BRL); por aluno se perSeat
  perSeat          Boolean        @default(false)
  minSeats         Int            @default(1)
  stripePriceId    String?        @unique
  maxStudents      Int? // null = ilimitado / por assento
  maxClasses       Int?
  features         String[] // ex.: ["white_label", "ai_tutor", "unlimited_jams"]
  aiMonthlyQuota   Int            @default(0)
  subscriptions    Subscription[]
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  READ_ONLY
}

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId               String
  plan                 Plan               @relation(fields: [planId], references: [id])
  status               SubscriptionStatus @default(TRIAL)
  seats                Int?
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  updatedAt            DateTime           @updatedAt
}

// Eventos do Stripe já processados (idempotência do webhook).
model StripeEvent {
  id          String   @id // evt_...
  type        String
  processedAt DateTime @default(now())
}

// ───────────────────────────── LGPD ─────────────────────────────

model ConsentRecord {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  document       String // ex.: "termos-v1", "dpa-v1"
  acceptedAt     DateTime     @default(now())
  ip             String?
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String?
  action         String // ex.: "aluno.excluir", "dados.exportar"
  target         String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
}

// ───────────────────────────── Ensino ─────────────────────────────

model Class {
  id             String       @id @default(cuid())
  name           String
  code           String       @unique // código da turma usado no login do aluno
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teacherId      String
  teacher        User         @relation("ClassTeacher", fields: [teacherId], references: [id])
  archived       Boolean      @default(false)
  createdAt      DateTime     @default(now())

  enrollments Enrollment[]
  courses     CourseAssignment[]
}

model Enrollment {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([classId, userId])
}

model Track {
  id             String        @id @default(cuid())
  slug           String
  title          String
  description    String
  story          String? // texto de abertura do “mundo” (narrativa)
  level          Int           @default(1) // 1 básico, 2 intermediário, 3 avançado
  order          Int           @default(0)
  published      Boolean       @default(false)
  organizationId String? // null = trilha oficial da plataforma
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  courseId       String?
  course         Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  modules        Module[]

  @@unique([organizationId, slug])
}

model Module {
  id      String   @id @default(cuid())
  trackId String
  track   Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  title   String
  order   Int      @default(0)
  lessons Lesson[]
}

enum LessonType {
  TEORIA
  DEMO
  EXERCICIO
  DESAFIO
}

enum LessonMode {
  EDITOR
  SB3
  AMBOS
}

model Lesson {
  id                String     @id @default(cuid())
  moduleId          String
  module            Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  slug              String
  title             String
  type              LessonType
  mode              LessonMode @default(EDITOR)
  order             Int        @default(0)
  content           String // markdown
  teacherGuide      String? // markdown, só para professores
  extra             String? // desafio extra opcional (alunos mais velhos/rápidos)
  optional          Boolean    @default(false) // missão extra (ex.: levar ao PictoBlox): não bloqueia a trilha
  starterWorkspace  Json?
  allowedBlocks     String[] // opcodes Scratch liberados na caixa de blocos
  checks            Json? // especificação de verificação
  xp                Int        @default(10)
  draft             Boolean    @default(false) // gerado por IA aguardando revisão

  progress     Progress[]
  submissions  Submission[]
  hintRequests HintRequest[]

  @@unique([moduleId, slug])
}

/// Curso = conjunto de trilhas. O professor libera o CURSO inteiro para a turma.
model Course {
  id             String        @id @default(cuid())
  slug           String
  title          String
  description    String
  order          Int           @default(0)
  published      Boolean       @default(false)
  comingSoon     Boolean       @default(false) // aparece como “em breve” e não pode ser liberado
  organizationId String? // null = curso oficial da plataforma
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tracks         Track[]
  assignments    CourseAssignment[]

  @@unique([organizationId, slug])
}

model CourseAssignment {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([classId, courseId])
}

enum ProgressStatus {
  NAO_INICIADO
  EM_ANDAMENTO
  CONCLUIDO
}

model Progress {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status    ProgressStatus @default(NAO_INICIADO)
  stars     Int            @default(0)
  attempts  Int            @default(0)
  updatedAt DateTime       @updatedAt

  @@unique([userId, lessonId])
}

model Submission {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  workspace      Json?
  sb3Url         String?
  result         Json
  stars          Int      @default(0)
  teacherComment String?
  createdAt      DateTime @default(now())

  @@index([lessonId, createdAt])
}

model Badge {
  id          String      @id // ex.: "primeiro-script"
  name        String
  description String
  icon        String
  users       UserBadge[]
}

model UserBadge {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@id([userId, badgeId])
}

model HintRequest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  level          Int
  inputTokens    Int          @default(0)
  outputTokens   Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

// ───────────────────────────── Game Jams ─────────────────────────────

/** Quem pode participar: escolas de todo o país, de estados, de cidades ou escolas convidadas. */
enum JamScope {
  PLATAFORMA
  ESTADOS
  CIDADES
  ESCOLAS
}

enum PrizeRecipient {
  ESCOLA
  EQUIPE
}

enum ProjectSource {
  SB3
  SITE
}

/**
 * Game jam. A fase (em breve / em andamento / julgamento / encerrada) é calculada pelo
 * relógio do servidor a partir das datas — nunca guardada (ver src/lib/jams.ts).
 */
model GameJam {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  theme         String
  description   String // markdown: regras e informações
  scope         JamScope  @default(PLATAFORMA)
  states        String[]
  cities        String[]
  orgIds        String[]
  startsAt      DateTime // entregas abrem
  endsAt        DateTime // entregas fecham
  judgingEndsAt DateTime // resultados revelados
  maxTeamSize   Int       @default(4)
  published     Boolean   @default(false)
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  prizes   JamPrize[]
  teams    JamTeam[]
  entries  JamEntry[]
  criteria JamCriterion[]
  judges   JamJudge[]
}

model JamPrize {
  id          String         @id @default(cuid())
  jamId       String
  jam         GameJam        @relation(fields: [jamId], references: [id], onDelete: Cascade)
  place       Int // 1 = primeiro lugar
  title       String
  description String         @default("")
  recipient   PrizeRecipient @default(EQUIPE)
}

/** Equipe inscrita por um professor. Nunca é mostrada aos jurados. */
model JamTeam {
  id             String          @id @default(cuid())
  jamId          String
  jam            GameJam         @relation(fields: [jamId], references: [id], onDelete: Cascade)
  name           String
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teacherId      String
  createdAt      DateTime        @default(now())
  members        JamTeamMember[]
  origin         JamEntryOrigin?
}

model JamTeamMember {
  teamId String
  team   JamTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
}

/**
 * Entrega anônima. NÃO tem ligação direta com equipe/escola: o vínculo fica em
 * JamEntryOrigin, que só o dono da plataforma lê (e só é revelado após o julgamento).
 */
model JamEntry {
  id            String          @id @default(cuid())
  jamId         String
  jam           GameJam         @relation(fields: [jamId], references: [id], onDelete: Cascade)
  anonCode      String // ex.: "K7Q2"
  title         String
  description   String
  youtubeId     String
  projectSource ProjectSource   @default(SB3)
  projectKey    String // chave aleatória no armazenamento
  docKey        String
  docExt        String // "pdf" | "docx"
  submittedAt   DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  origin        JamEntryOrigin?
  scores        JamScore[]
  feedbacks     JamFeedback[]

  @@unique([jamId, anonCode])
}

model JamEntryOrigin {
  entryId String   @id
  entry   JamEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  teamId  String   @unique
  team    JamTeam  @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model JamCriterion {
  id       String     @id @default(cuid())
  jamId    String
  jam      GameJam    @relation(fields: [jamId], references: [id], onDelete: Cascade)
  name     String // ex.: "Criatividade", "Uso do tema", "Jogabilidade"
  weight   Float      @default(1)
  maxScore Int        @default(10)
  order    Int        @default(0)
  scores   JamScore[]
}

model JamJudge {
  jamId  String
  jam    GameJam @relation(fields: [jamId], references: [id], onDelete: Cascade)
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([jamId, userId])
}

model JamScore {
  id          String       @id @default(cuid())
  entryId     String
  entry       JamEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  criterionId String
  criterion   JamCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  judgeId     String
  judge       User         @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  value       Int

  @@unique([entryId, criterionId, judgeId])
}

model JamFeedback {
  id        String   @id @default(cuid())
  entryId   String
  entry     JamEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  judgeId   String
  judge     User     @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entryId, judgeId])
}

// ───────────────────────────── Avisos da plataforma ─────────────────────────────

/** Aviso/notícia do dono da plataforma para escolas. Alvos vazios = todos. */
model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String // markdown
  states      String[] // UFs alvo
  cities      String[] // cidades alvo
  orgIds      String[] // escolas específicas
  roles       Role[] // papéis alvo (padrão: coordenação e professores)
  publishedAt DateTime  @default(now())
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  reads AnnouncementRead[]
}

model AnnouncementRead {
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@id([announcementId, userId])
}
